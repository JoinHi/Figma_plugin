# macOS
.DS_Store

# Dependencies
node_modules/

# Local service runtime files
.export-service.pid
export-service.log

# Package manager noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Figma export outputs generated by this plugin.
# Export folders are arbitrary top-level names, for example:
#   splash/design.json
#   splash/preview.png
#   splash/assets/image-001.png
/*/design.json
/*/preview.png
/*/assets/
/*/previews/

# Optional archives users may create manually
*.zip
